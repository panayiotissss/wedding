# ─────────────────────────────────────────────────────────────────────────
# Confetti — environment template. Copy to `.env` and fill in REAL values.
# Never put real secrets in THIS file — it is committed to git. `.env` is not.
# ─────────────────────────────────────────────────────────────────────────

# ── R2 / object storage (required) ──
# R2_ACCOUNT_ID is optional/unused (the app reads R2_ENDPOINT); kept for parity.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# ── App (required) ──
# Long random string — signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Postgres connection string (Neon / Render free tier).
# postgres:// and postgresql:// are both accepted (auto-normalized to psycopg).
DATABASE_URL=postgresql://user:pass@host/dbname

# ── App (optional) ──
# Public origin — used to build QR codes and share links. Set in production.
PUBLIC_BASE_URL=http://localhost:8000
# Set to false ONLY for local http://localhost testing (cookies over http).
COOKIE_SECURE=false
# How long a paid gallery lives before auto-deletion (WED-6).
EVENT_TTL_DAYS=365
# Protects POST /api/admin/cleanup. Leave blank to keep it disabled.
ADMIN_TOKEN=

# ── Stripe (optional) ──
# Leave BOTH blank to run in STUB mode: galleries unlock instantly with no
# payment, so you can demo the whole flow. Set both to require real payment.
STRIPE_PAYMENT_LINK_URL=
STRIPE_WEBHOOK_SECRET=
